{
  "manifest_version": 3,
  "name": "CreatorPulse for YouTube (Local)",
  "version": "0.5.0",
  "description": "Local-first YouTube video scorecard and creator tools. Official API data only when connected.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches":["https://www.youtube.com/*"],"js":["content.js"],"run_at":"document_idle"}],
  "action": {"default_popup":"popup.html"}
}
