{
  "manifest_version": 3,
  "name": "CreatorPulse for YouTube",
  "version": "0.5.0",
  "description": "YouTube video scorecard and creator tools for the hosted CreatorPulse service. Official API data only when connected.",
  "permissions": ["storage"],
  "host_permissions": ["https://creatorpulse-open-source-app.onrender.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches":["https://www.youtube.com/*"],"js":["content.js"],"run_at":"document_idle"}],
  "action": {"default_popup":"popup.html"}
}
